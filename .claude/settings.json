{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/okf-for-path.sh",
            "timeout": 30,
            "statusMessage": "Checking project memory for this file"
          }
        ]
      }
    ]
  }
}
