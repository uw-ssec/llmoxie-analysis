# pixi environments
.pixi/*
!.pixi/config.toml

# Python build artifacts
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# Testing and tooling caches
.pytest_cache/
.coverage
.mypy_cache/
.ruff_cache/

# MkDocs build output
site/

# Obsidian vault settings, created when knowledge/ is opened as a vault
knowledge/.obsidian/

# Skill evals: run logs and the skills copy synced into harbor build contexts
evals/logs/
evals/harbor/tasks/*/environment/skills/

# MacOS
.DS_Store
